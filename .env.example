# Copy to .env and fill in. .env holds passwords and is ignored by git.

# The R700 to monitor, and its root (RShell / REST API) login.
READER_HOST=192.0.2.10
READER_USER=root
READER_PASSWORD=change-me

# SmartReader CAP web admin login (HTTPS port 8443).
CAP_USER=admin
CAP_PASSWORD=change-me

# Read-only SNMP community the lab enables on the reader, and the trap community.
SNMP_COMMUNITY=change-me-ro
SNMP_TRAP_COMMUNITY=change-me-trap

# This PC's address on the reader's network; the reader sends its SNMP traps here.
LAB_HOST_IP=192.0.2.20

# Source address of the reader's traps as Zabbix sees it. Docker Desktop rewrites it to the lab network's
# gateway (172.31.67.1, the default). On Docker Engine for Linux, set it to the reader's IP (READER_HOST).
TRAP_SOURCE_IP=172.31.67.1

# Antenna ports with an antenna attached (regex on the port number), e.g. ^1$ or ^(1|2)$.
R700_ANTENNAS=.*

# Time zone for the Zabbix web UI.
PHP_TZ=UTC

# Zabbix web login. Admin / zabbix is the image default; change it in the UI if the lab is shared.
ZBX_WEB_USER=Admin
ZBX_WEB_PASSWORD=zabbix

# Zabbix database (local container only).
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zabbix

# ---- Optional: SNMPv3 from SmartReader's own agent (EXPERIMENTAL) -------------------------------------
# No released SmartReader CAP ships this agent yet; see docs/smartreader-snmpv3.md. Leave
# SR_SNMPV3_ENABLED=0 and the lab stays exactly as above (the reader's own agent over SNMP v2c).
# 1 = poll the CAP's SNMPv3 agent on READER_HOST:SR_SNMPV3_PORT, on the same Zabbix host as the reader.
SR_SNMPV3_ENABLED=0
# 1 = also add a host for the simulator (docker compose --profile snmpv3-sim up -d).
SR_SNMPV3_SIMULATOR=0
SR_SNMPV3_PORT=1161
# USM user. Protocols in Zabbix spelling: SHA1 SHA224 SHA256 SHA384 SHA512 / AES128 AES192 AES256.
# For a reader, set the user and both passphrases on the CAP's SNMP Monitoring page, then type the two
# passphrases here (the CAP never returns them) and run `python smartreader_snmpv3.py credentials` to copy
# the enabled flag, port, user and protocols from the CAP. The simulator takes whatever you put here.
SR_SNMPV3_USER=
SR_SNMPV3_AUTH_PROTOCOL=SHA256
SR_SNMPV3_AUTH_PASSPHRASE=
SR_SNMPV3_PRIV_PROTOCOL=AES128
SR_SNMPV3_PRIV_PASSPHRASE=
# Root of SmartReader's objects. Provisional until the final arc is allocated; then only this changes.
SR_SNMP_ROOT=1.3.6.1.4.1.8072.9999.9999.7
